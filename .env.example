# Local MQTT broker
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=client
MQTT_PASSWORD=Cl!EnT&Pass
MQTT_TOPIC=test/your_name
MQTT_QOS=1
MQTT_CONNECT_TIMEOUT=5
MQTT_SOCKET_TIMEOUT=5
MQTT_KEEP_ALIVE=30

# Soketi
PUSHER_APP_ID=mqtt-test
PUSHER_APP_KEY=mqtt-test-key
PUSHER_APP_SECRET=mqtt-test-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_CHANNEL=mqtt.telemetry
PUSHER_EVENT=telemetry.updated

# Redis
REDIS_URL=redis://redis:6379
IDEMPOTENCY_TTL=3600

# Resilience
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=10

# Publisher
PUBLISH_INTERVAL_SECONDS=1

# Logging
LOG_LEVEL=info
